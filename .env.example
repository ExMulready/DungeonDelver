# ─────────────────────────────────────────────────────────────────────────────
#  DungeonDelver environment
#
#  Copy to `.env` and fill in. The same codebase runs two ways; the variables
#  below are what decide which.
#
#    Docker Compose (free, offline)  →  LLM_PROVIDER=ollama   CHRONICLE_STORE=both
#    Vercel (public deploy)          →  LLM_PROVIDER=groq     CHRONICLE_STORE=pg
# ─────────────────────────────────────────────────────────────────────────────

# ── Which narrator drives the campaign ───────────────────────────────────────
# ollama = local model in the container stack. Free and offline, but slow and
#          noticeably weaker prose on a machine without a dedicated GPU.
# groq   = hosted API. Fast and far better prose. Needs a free key, and your
#          prompts leave the machine.
LLM_PROVIDER=ollama

# ── Ollama (LLM_PROVIDER=ollama) ─────────────────────────────────────────────
# Inside Compose the service name resolves; outside it, use localhost:11434.
OLLAMA_BASE_URL=http://ollama:11434/v1

# Pinned to a NON-thinking instruct model on purpose. A reasoning model spends
# its token budget on hidden deliberation, which is ruinous at ~10 tok/s.
#   qwen3.5:2b                     ~1.4 GB  default, fits this machine
#   qwen3:4b-instruct-2507-q4_K_M  ~2.5 GB  better prose, needs headroom
#   qwen3:1.7b                     ~1.0 GB  fallback if the host thrashes
OLLAMA_MODEL=qwen3.5:2b

# ── Groq (LLM_PROVIDER=groq) ─────────────────────────────────────────────────
# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ─────────────────────────────────────────────────────────────────
# Compose: the bundled Postgres service.
DATABASE_URL=postgresql://delver:delver@postgres:5432/dungeondelver
# Supabase: Project Settings → Database → Connection string → Transaction pooler.
# Must be the pooler (port 6543) on Vercel; direct connections exhaust quickly.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Chronicle storage ────────────────────────────────────────────────────────
# fs   = real .md files on disk only (no database row)
# pg   = database text column only — REQUIRED on Vercel, which has no writable disk
# both = writes to both, so you can `cat` a chronicle while playing locally
CHRONICLE_STORE=both
CHRONICLE_DIR=/data/campaigns

# ── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=
# Local: http://localhost:3000 — Vercel sets this automatically on its own domains.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URIs must include BOTH:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
