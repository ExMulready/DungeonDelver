# syntax=docker/dockerfile:1
#
# Vercel container image.
#
# Vercel builds this by filename convention — `Dockerfile.vercel` at the project
# root — and runs the result as a Function backed by an OCI image:
# https://vercel.com/docs/functions/container-images
#
# Kept separate from ./Dockerfile rather than parameterised with build args,
# because the two targets differ in ways that are not a flag:
#
#   ./Dockerfile         Compose. Ollama + a Postgres container, and a bind-mounted
#                        /data volume so chronicles can be read from the host.
#   ./Dockerfile.vercel  Vercel. Supabase + Groq, no writable disk at all, and a
#                        port assigned at runtime rather than chosen.
#
# A Vercel container is still a stateless request-serving unit: it has no
# sidecars, so CHRONICLE_STORE must be `pg` and LLM_PROVIDER must be `groq`.
# There is nowhere for a chronicle file or a local model to live.

FROM node:22-bookworm-slim AS base


# ── deps ─────────────────────────────────────────────────────────────────────
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci


# ── builder ──────────────────────────────────────────────────────────────────
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# next/font/google downloads and self-hosts the typefaces at BUILD time, so this
# stage needs network access. The running container never calls out to a CDN.
ENV NEXT_TELEMETRY_DISABLED=1

# No database credentials needed to build: the Drizzle client connects lazily on
# first use (src/lib/db/index.ts) and no route is prerendered against real data.
RUN npm run build


# ── runner ───────────────────────────────────────────────────────────────────
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs delver

# `output: "standalone"` traces exactly the files the server needs, so no
# node_modules copy is required here.
COPY --from=builder --chown=delver:nodejs /app/.next/standalone ./
COPY --from=builder --chown=delver:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=delver:nodejs /app/public ./public

USER delver

# No ENV PORT and no EXPOSE of a fixed port on purpose: Vercel assigns $PORT at
# runtime, and Next's standalone server reads it. Hardcoding 3000 the way the
# Compose image does would bind the wrong port and the container would never
# pass a health check.
CMD ["node", "server.js"]
